ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 선택: 기본값은 claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# 데이터 저장 (Supabase — supabase.com 프로젝트 생성 후 Settings → API에서 확인)
# 심사역 정보, 메일 분류 결과, 감시 상태, 발송 이력을 전부 여기에 저장함 (파일 저장 아님)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 메일함 자동 분류 기능에 필요 (POP3)
MAIL_HOST=pop.example.com
MAIL_PORT=995
MAIL_USER=shared@example.com
MAIL_PASSWORD=

# 선택: 메일 분류에 쓸 모델 (기본값 claude-haiku-4-5)
# MAIL_CLASSIFY_MODEL=claude-haiku-4-5

# 선택: 사내 발신자 판별용 회사 도메인 (기본값 andaasiavc.com)
# COMPANY_MAIL_DOMAIN=andaasiavc.com

# 선택: 배포 후 이메일 알림에 넣을 대시보드 링크 베이스 URL (기본값 http://localhost:3000)
# APP_BASE_URL=

# 이메일 알림 발송 (Resend API — resend.com 가입 후 API Key 발급. Railway 등 PaaS는 보통 아웃바운드
# SMTP 포트를 막아두므로 SMTP 대신 HTTPS 기반 Resend를 씀)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 선택: 발신 표시명/주소 — 도메인 인증 전이면 반드시 resend.dev 주소를 써야 함
# RESEND_FROM_EMAIL=AI 심사역 메일함 알림 <onboarding@resend.dev>

# 선택: 정부지원사업·협업제안 등 관리팀 카테고리 메일을 받을 이메일 (없으면 조용히 스킵됨)
# ADMIN_TEAM_EMAIL=

# 선택: Vercel Cron(매일 신규 메일 확인, vercel.json 참고)이 이 값을 Authorization 헤더로 자동 첨부함 —
# 설정해두면 /api/cron/mail-watch를 아무나 호출 못 하게 막아줌. 로컬 개발에는 필요 없음.
# CRON_SECRET=

# 내부 도구(온보딩/메일함/대시보드) 접근 비밀번호 — /internal-login에서 입력받아 쿠키로 확인함.
# 운영(Vercel) 환경에서는 필수: 설정 안 하면 내부 도구가 전부 막힘(안전을 위한 기본 동작).
# INTERNAL_ACCESS_PASSWORD=
